{
  "name": "smoke-less-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-vape.mjs",
    "preview": "vite preview",
    "check:release": "node scripts/check-release-readiness.mjs",
    "test": "node --test scripts/preview-release-contract.test.mjs scripts/sync-preview-release.integration.test.mjs && npm --prefix apps/vape test",
    "verify": "npm test && npm run build && npm run check:release"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "motion": "^12.23.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
